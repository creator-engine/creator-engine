{
  "_comment": "ADR-0007 egress broker — per-App config template covering dev-1/2/3/4. Copy to a host-local path (e.g. ~/.ce-egress/broker.json), fill the real App ids + installation ids, and keep the PEMs RAM-only (/dev/shm). This file is a TEMPLATE: app_id / installation_id placeholders must be replaced by the controller before a live --apply run. The PEM is never read by the broker process — only by `openssl` at sign time.",

  "repo": "creator-engine/creator-engine",
  "installation_owner": "creator-engine",
  "audit_log": "~/.ce-egress/audit.jsonl",

  "policy": {
    "base_branch": "main",
    "allowed_branch_namespaces": ["ce-", "ce-ops-", "v3-", "v35-", "feat/", "fix/", "bugfix-", "chore/", "docs/"],
    "forbidden_branches": ["main", "master", "develop", "gh-pages", "release"],
    "authorized_emails": [],
    "authorized_logins": ["cedev1vps-cmd", "ubuntuaws745-cmyk", "ce-dev-3", "cedev4vps-coder"],
    "max_pushes_per_window": 30,
    "window_seconds": 3600
  },

  "seats": {
    "dev-1": {
      "app_id": "REPLACE_WITH_DEV1_APP_ID",
      "app_owner": "cedev1vps-cmd",
      "pem_path": "/dev/shm/ce-dev1/ce-forge-dev1.pem",
      "installation_id": null
    },
    "dev-2": {
      "app_id": "4025879",
      "app_owner": "ubuntuaws745-cmyk",
      "pem_path": "/dev/shm/ce-dev2/ce-forge-dev2.pem",
      "installation_id": null
    },
    "dev-3": {
      "app_id": "REPLACE_WITH_DEV3_APP_ID",
      "app_owner": "ce-dev-3",
      "pem_path": "/dev/shm/ce-dev3/ce-forge-dev3.pem",
      "installation_id": null
    },
    "dev-4": {
      "app_id": "4085526",
      "app_owner": "cedev4vps-coder",
      "pem_path": "/dev/shm/ce-dev4/ce-forge-dev4.pem",
      "installation_id": null
    }
  }
