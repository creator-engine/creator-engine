[Unit]
Description=Creator Engine conveyor harvest daemon (shadow mode)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
User=creator-engine
WorkingDirectory=/workspace/creator-engine
EnvironmentFile=/etc/creator-engine/ce-conveyor-daemon.env
Environment=CE_CONVEYOR_DAEMON_REPO_ROOT=/workspace/creator-engine
Environment=CE_DAEMON_REPO_ROOT=/workspace/creator-engine
Environment=CE_DAEMON_STATE_ROOT=/var/lib/ce-conveyor-daemon
Environment=CE_DAEMON_CONTAINER_NAME=ce-conveyor-daemon
ExecStart=/bin/bash -lc 'if [ "${CE_DAEMON_UNCONTAINED:-0}" = "1" ]; then exec /workspace/creator-engine/deploy/conveyor-daemon/launch-conveyor-daemon.sh; else exec /workspace/creator-engine/deploy/daemons/run-daemon-container.sh conveyor-daemon; fi'
Restart=always
RestartSec=5
RuntimeDirectory=ce-conveyor-daemon
RuntimeDirectoryMode=0700
StateDirectory=ce-conveyor-daemon
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ce-conveyor-daemon

# Shadow mode: deliberately disabled. Enable only after Operator-gated deployment flip.
