# Copy to /etc/creator-engine/ce-review-spawn-provider.env with mode 0600.
# Default OFF: capacity=0 refuses all spawn attempts.  No service/timer is
# enabled by this carrier; the Operator owns production deployment and alerts.
CE_REVIEW_SPAWN_CAPACITY=0
CE_REVIEW_SPAWN_TIMEOUT_SECONDS=180
CE_REVIEW_SPAWN_RETENTION_SECONDS=86400
CE_REVIEW_SPAWN_SANDBOX_ATTESTATION=0
# Explicit controller-owned roots and reviewer registry are required when armed.
# CE_REVIEW_SPAWN_STATE_ROOT=/var/lib/creator-engine/review-spawn
# CE_REVIEW_SPAWN_WORKTREE_ROOT=/var/lib/creator-engine/review-worktrees
# CE_REVIEW_SPAWN_EVIDENCE_ROOT=/var/lib/creator-engine/review-evidence
# CE_REVIEW_SPAWN_REVIEWER_REGISTRY=/etc/creator-engine/governed-reviewers.json
