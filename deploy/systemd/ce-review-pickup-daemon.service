[Unit]
Description=Creator Engine review pickup daemon
Documentation=./README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/creator-engine/gate-daemons.env
WorkingDirectory=/workspace/creator-engine
Environment=PYTHONPATH=validators
ExecStart=.venv/bin/python -m creator_engine_validator.v3_cli review-pickup --identity ce-dev-2 --repo "$CE_GATE_REPO" --seat ce-dev-1,ce-dev-3,ce-dev-4 --loop --interval 120 --apply --json
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
