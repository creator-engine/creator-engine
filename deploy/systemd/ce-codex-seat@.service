[Unit]
Description=Creator Engine detached Codex seat container (%i)
Documentation=file:/workspace/creator-engine/deploy/systemd/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/workspace/creator-engine
Environment=CE_CODEX_SEAT_LAUNCHER=deploy/dgx-runsc/run-codex-runsc.sh CE_CODEX_SEAT_CONTAINER_NAME=ce-dgx-codex CE_DGX_DETACH=1 CE_VPS_DETACH=1
EnvironmentFile=-/etc/creator-engine/ce-codex-seat-%i.env
ExecStartPre=-/bin/bash -lc 'container_name="${CE_CODEX_SEAT_CONTAINER_NAME:-${CE_DGX_CONTAINER_NAME:-${CE_VPS_CONTAINER_NAME:-ce-dgx-codex}}}"; docker rm -f "${container_name}"'
ExecStart=/bin/bash -lc 'container_name="${CE_CODEX_SEAT_CONTAINER_NAME:-${CE_DGX_CONTAINER_NAME:-${CE_VPS_CONTAINER_NAME:-ce-dgx-codex}}}"; export CE_CODEX_SEAT_CONTAINER_NAME="${container_name}"; case "${CE_CODEX_SEAT_LAUNCHER}" in *vps-runsc*) export CE_VPS_CONTAINER_NAME="${CE_VPS_CONTAINER_NAME:-${container_name}}" ;; *) export CE_DGX_CONTAINER_NAME="${CE_DGX_CONTAINER_NAME:-${container_name}}" ;; esac; "${CE_CODEX_SEAT_LAUNCHER}" --detach tui; exec docker wait "${container_name}"'
ExecStop=/bin/bash -lc 'container_name="${CE_CODEX_SEAT_CONTAINER_NAME:-${CE_DGX_CONTAINER_NAME:-${CE_VPS_CONTAINER_NAME:-ce-dgx-codex}}}"; docker rm -f "${container_name}"'
Restart=always
RestartSec=15s
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
