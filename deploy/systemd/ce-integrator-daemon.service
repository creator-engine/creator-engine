[Unit]
Description=Creator Engine Integrator merge-queue daemon
Documentation=./README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/creator-engine/gate-daemons.env
WorkingDirectory=/workspace/creator-engine
ExecStart=/usr/bin/env cev3 queue-daemon --repo "$CE_GATE_REPO" --loop --interval 120 --authorized-reviewer "$CE_GATE_AUTHORIZED_REVIEWERS" --json
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
