[Unit]
Description=Creator Engine Integrator merge-queue daemon
Documentation=./README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/creator-engine/gate-daemons.env
WorkingDirectory=/workspace/creator-engine
Environment=PYTHONPATH=validators
ExecStart=.venv/bin/python -m creator_engine_validator.v3_cli queue-daemon --repo "$CE_GATE_REPO" --loop --interval 120 --json
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
