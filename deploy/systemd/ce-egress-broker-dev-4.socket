[Unit]
Description=Creator Engine contained-seat self-push egress broker socket (dev-4)
Documentation=https://github.com/creator-engine/creator-engine/tree/main/tools/egress-broker

[Socket]
ListenStream=/run/ce-egress/dev-4.sock
SocketMode=0660
SocketGroup=ce-egress-4
DirectoryMode=0755
RemoveOnStop=no
Service=ce-egress-broker-dev-4.service

[Install]
WantedBy=sockets.target
