[Unit]
Description=Creator Engine contained-seat self-review broker socket
Documentation=https://github.com/creator-engine/creator-engine/tree/main/tools/egress-broker

[Socket]
ListenStream=/run/ce-egress/dev-3-review.sock
SocketMode=0660
SocketGroup=ce-dev-3
DirectoryMode=0755
RemoveOnStop=no
Service=ce-egress-self-review.service

[Install]
WantedBy=sockets.target
