# Copy to /etc/creator-engine/ce-materializer.env with mode 0600.
# This daemon is intentionally dry-run-only. Do not place app private keys or
# other long-lived write credentials in this file.

CE_GATE_REPO=creator-engine/creator-engine
CE_MATERIALIZER_INTERVAL_SECONDS=120
CE_MATERIALIZER_MAIN_REF=origin/main
CE_MATERIALIZER_TAIL_REF=main
CE_MATERIALIZER_DRY_RUN=1
CE_MATERIALIZER_PYTHON=/workspace/creator-engine/.venv/bin/python
CE_MATERIALIZER_STATE_ROOT=/workspace/creator-engine/.ce/state/brain-intent-materializer
CE_MATERIALIZER_QUARANTINE_ROOT=/workspace/creator-engine/.ce/state/brain-intent-quarantine

# Optional bounded-loop value for smoke tests and controlled maintenance.
# Leave unset for a supervised daemon.
# CE_MATERIALIZER_ITERATIONS=1
