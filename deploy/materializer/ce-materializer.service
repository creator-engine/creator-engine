[Unit]
Description=Creator Engine brain intent materializer dry-run daemon
Documentation=file:/workspace/creator-engine/deploy/materializer/ce-materializer.env.example
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
User=creator-engine
WorkingDirectory=/workspace/creator-engine
EnvironmentFile=/etc/creator-engine/ce-materializer.env
Environment=CE_MATERIALIZER_REPO_ROOT=/workspace/creator-engine
Environment=CE_DAEMON_REPO_ROOT=/workspace/creator-engine
Environment=CE_DAEMON_STATE_ROOT=/var/lib/ce-materializer
Environment=CE_DAEMON_CONTAINER_NAME=ce-materializer
Environment=CE_MATERIALIZER_STATE_ROOT=/workspace/creator-engine/.ce/state/brain-intent-materializer
Environment=CE_MATERIALIZER_QUARANTINE_ROOT=/workspace/creator-engine/.ce/state/brain-intent-quarantine
Environment=CE_MATERIALIZER_DRY_RUN=1
ExecStart=/bin/bash -lc 'exec /workspace/creator-engine/deploy/materializer/launch-materializer.sh'
Restart=always
RestartSec=5
RuntimeDirectory=ce-materializer
RuntimeDirectoryMode=0700
StateDirectory=ce-materializer
StateDirectoryMode=0700
LogsDirectory=ce-materializer
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ce-materializer

[Install]
WantedBy=multi-user.target
