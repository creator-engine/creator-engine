[Unit]
Description=Daily trigger for Creator Engine scratch-storage reaper (F-1.3)
Documentation=deploy/storage-reaper/reap-scratch.sh

[Timer]
# Run once a day, randomised across a 30-minute window to avoid thundering
# herd on multi-host deployments sharing the same infra clock.
OnCalendar=daily
RandomizedDelaySec=1800
# Always catch up on a missed run (e.g. host was down at the scheduled time).
Persistent=true

[Install]
WantedBy=timers.target
